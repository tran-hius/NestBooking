{
  "openapi": "3.0.0",
  "info": {
    "title": "Review Service API",
    "description": "Tài liệu API của Module Review",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "basePath": "",
  "paths": {
    "/": {
      "post": {
        "description": "",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/hotel/{hotelId}": {
      "get": {
        "description": "",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/{id}": {
      "put": {
        "description": "",
        "responses": {
          "default": {
            "description": ""
          }
        }
      },
      "delete": {
        "description": "",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CreateReviewDto": {
        "type": "object",
        "properties": {
          "hotelId": {
            "type": "string",
            "example": "uuid-1234"
          },
          "rating": {
            "type": "number",
            "example": 5
          },
          "comment": {
            "type": "string",
            "example": "Khách sạn tuyệt vời"
          }
        },
        "required": [
          "hotelId",
          "rating"
        ]
      },
      "UpdateReviewDto": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "number",
            "example": 4
          },
          "comment": {
            "type": "string",
            "example": "Khách sạn khá tốt"
          }
        }
      }
    }
  }
}