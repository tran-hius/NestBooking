// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AGENT
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
  BANNED
}

enum HotelStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
}

enum RoomStatus {
  AVAILABLE
  BOOKED
  OCCUPIED
  MAINTENANCE
}

enum BedType {
  SINGLE
  DOUBLE
  QUEEN
  KING
  TWIN
  BUNK
}

enum PropertyType {
  HOTEL // KhÃ¡ch sáº¡n
  RESORT // Khu nghá»‰ dÆ°á»¡ng
  VILLA // Biá»‡t thá»±
  APARTMENT // CÄƒn há»™
  HOMESTAY // Homestay
  GUESTHOUSE // NhÃ  nghá»‰
  MOTEL // Motel dá»c Ä‘Æ°á»ng
  CAMPING // Khu cáº¯m tráº¡i
  GLAMPING // Cáº¯m tráº¡i sang cháº£nh
  CRUISE // Du thuyá»n
  ENTIRE_HOUSE // NguyÃªn cÄƒn nhÃ 
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CANCELLED
  COMPLETED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(255)
  passwordHash  String?        @map("password_hash") @db.VarChar(255)
  role          Role           @default(USER)
  status        UserStatus     @default(INACTIVE)
  loginAttempts Int            @default(0) @map("login_attempts")
  lockUntil     DateTime?      @map("lock_until")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")
  profile       UserProfile?
  hotels        Hotel[]
  refreshTokens RefreshToken[]
  bookings      Booking[]
  reviews       Review[]
  notifications Notification[]

  @@map("users")
}

model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  fullName    String?  @map("full_name") @db.VarChar(100)
  phoneNumber String?  @unique @map("phone_number") @db.VarChar(15)
  avatarUrl   String?  @map("avatar_url") @db.Text
  address     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}



model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @map("token_hash") @db.VarChar(255)
  deviceName   String?   @map("device_name") @db.VarChar(100)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.Text
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason") @db.VarChar(100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Hotel {
  id           String       @id @default(uuid()) @db.Uuid
  ownerId      String       @map("owner_id") @db.Uuid
  name         String       @db.VarChar(255)
  slug         String       @unique @db.VarChar(255)
  description  String?      @db.Text
  address      String       @db.Text
  city         String       @db.VarChar(100)
  country      String       @default("Vietnam") @db.VarChar(100)
  latitude     Decimal?     @db.Decimal(10, 8)
  longitude    Decimal?     @db.Decimal(11, 8)
  phone        String?      @db.VarChar(20)
  email        String?      @db.VarChar(255)
  thumbnail    String?      @db.Text
  amenities    String[]     @default([])
  rating       Float        @default(0)
  checkInTime  String?      @map("check_in_time") @db.VarChar(10)
  checkOutTime String?      @map("check_out_time") @db.VarChar(10)
  status       HotelStatus  @default(PENDING)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")
  propertyType PropertyType @default(HOTEL) @map("property_type")
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images       HotelImage[]
  rooms        Room[]
  roomTypes    RoomType[]
  bookings     Booking[]
  reviews      Review[]

  @@map("hotels")
}

model HotelImage {
  id        String   @id @default(uuid()) @db.Uuid
  hotelId   String   @map("hotel_id") @db.Uuid
  imageUrl  String   @map("image_url") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("hotel_images")
}

model RoomType {
  id          String          @id @default(uuid()) @db.Uuid
  hotelId     String          @map("hotel_id") @db.Uuid
  name        String          @db.VarChar(150)
  description String?         @db.Text
  price       Decimal         @db.Decimal(12, 2)
  maxGuests   Int             @map("max_guests")
  maxAdults   Int             @map("max_adults")
  maxChildren Int             @map("max_children")
  bedType     BedType         @map("bed_type")
  bedCount    Int             @map("bed_count")
  area        Float?
  thumbnail   String?         @db.Text
  isActive    Boolean         @default(true) @map("is_active")
  amenities   String[]        @default([])
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  hotel       Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms       Room[]
  images      RoomTypeImage[]
  bookings    Booking[]

  @@unique([hotelId, name])
  @@map("room_types")
}

model Room {
  id         String     @id @default(uuid()) @db.Uuid
  hotelId    String     @map("hotel_id") @db.Uuid
  roomTypeId String     @map("room_type_id") @db.Uuid
  roomNumber String     @map("room_number") @db.VarChar(30)
  floor      Int?
  status     RoomStatus @default(AVAILABLE)
  note       String?    @db.Text
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  hotel      Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  bookings   BookingRoom[]

  @@unique([hotelId, roomNumber])
  @@map("rooms")
}

model BookingRoom {
  bookingId String @map("booking_id") @db.Uuid
  roomId    String @map("room_id") @db.Uuid
  
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([bookingId, roomId])
  @@map("booking_rooms")
}

model RoomTypeImage {
  id         String   @id @default(uuid()) @db.Uuid
  roomTypeId String   @map("room_type_id") @db.Uuid
  imageUrl   String   @map("image_url") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@map("room_type_images")
}

enum PaymentMethod {
  VNPAY
  MOMO
  ZALOPAY
  CREDIT_CARD
  PAY_AT_HOTEL
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Booking {
  id          String @id @default(uuid()) @db.Uuid
  bookingCode String @unique @map("booking_code") @db.VarChar(30)

  userId     String @map("user_id") @db.Uuid
  hotelId    String @map("hotel_id") @db.Uuid
  roomTypeId String @map("room_type_id") @db.Uuid

  checkInDate  DateTime @map("check_in_date")
  checkOutDate DateTime @map("check_out_date")
  quantity     Int      @default(1)

  totalAmount Decimal       @map("total_amount") @db.Decimal(12, 2)
  status      BookingStatus @default(PENDING)

  paymentMethod PaymentMethod @default(PAY_AT_HOTEL) @map("payment_method")
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  paymentDate   DateTime?     @map("payment_date")

  transactionId String? @unique @map("transaction_id")
  refundTxId    String? @map("refund_tx_id")

  guestName       String  @map("guest_name") @db.VarChar(100)
  guestPhone      String  @map("guest_phone") @db.VarChar(15)
  guestEmail      String  @map("guest_email") @db.VarChar(255)
  specialRequests String? @map("special_requests") @db.Text

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id])
  hotel    Hotel    @relation(fields: [hotelId], references: [id])
  roomType RoomType @relation(fields: [roomTypeId], references: [id])
  rooms    BookingRoom[]

  @@map("bookings")
}

model Destination {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  imageUrl    String   @map("image_url") @db.Text
  country     String   @default("Vietnam") @db.VarChar(100)
  countryFlag String   @default("VN") @map("country_flag") @db.VarChar(10)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("destinations")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  hotelId   String   @map("hotel_id") @db.Uuid
  rating    Int      @default(5)
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

enum NotificationType {
  BOOKING_SUCCESS
  BOOKING_CANCELLED
  SYSTEM
  PROMOTION
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String           @db.VarChar(255)
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

